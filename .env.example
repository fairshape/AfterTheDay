# Leave both values blank for a fictional, web-only demo.
BOT_TOKEN=
WEBAPP_URL=
# The username is detected automatically in Telegram mode. Override if needed at startup.
BOT_USERNAME=
# Optional Telegram file IDs usable by this bot.
WELCOME_STICKER_ID=
FIRST_SAVE_STICKER_ID=
# DEMO_MODE=true forces web-only mode even if Telegram credentials exist.
DEMO_MODE=false
APP_TIMEZONE=Asia/Almaty
HOST=127.0.0.1
PORT=8000
DATA_DIR=var
AUTO_MIGRATE=true

MUSIC_STOREFRONT=KZ
CATALOGUE_TIMEOUT=4

# Local Piper speech models. Download using the setup command in README.
VOICE_DIRECTORY=var/voices
VOICE_ONE_MODEL=ru_RU-irina-medium
VOICE_TWO_MODEL=ru_RU-denis-medium
SPEECH_TIMEOUT=75
ASSEMBLY_STICKER_ID=
ANNIVERSARY_STICKER_ID=
